{
  "openapi": "3.1.0",
  "info": {
    "title": "CardVault network-mock",
    "description": "A controllable stand-in for the card network: issues wallet tokens, simulates wallet and card purchases (authorizations to card-service) and clearing records.",
    "version": "0.1.0"
  },
  "paths": {
    "/health": {
      "get": {
        "tags": [
          "health"
        ],
        "summary": "Liveness",
        "description": "200 while the process is up.",
        "operationId": "health_health_get",
        "responses": {
          "200": {
            "description": "Successful Response",
            "content": {
              "application/json": {
                "schema": {
                  "additionalProperties": true,
                  "type": "object",
                  "title": "Response Health Health Get"
                }
              }
            }
          }
        }
      }
    },
    "/ready": {
      "get": {
        "tags": [
          "health"
        ],
        "summary": "Readiness",
        "description": "200 when the service's database (and Kafka, if it uses Kafka) answer.",
        "operationId": "ready_ready_get",
        "responses": {
          "200": {
            "description": "Successful Response",
            "content": {
              "application/json": {
                "schema": {}
              }
            }
          },
          "503": {
            "description": "A dependency is not reachable"
          }
        }
      }
    },
    "/v1/tokens": {
      "post": {
        "tags": [
          "tokens"
        ],
        "summary": "Issue a wallet token",
        "description": "Called by the wallet operator during enrolment. Maps a new token_ref to the card_id; purchases with that token are routed to that card.",
        "operationId": "issue_token_v1_tokens_post",
        "requestBody": {
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/TokenRequest"
              }
            }
          },
          "required": true
        },
        "responses": {
          "201": {
            "description": "Successful Response",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/TokenResponse"
                }
              }
            }
          },
          "401": {
            "description": "Unauthorized",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ErrorBody"
                }
              }
            }
          },
          "422": {
            "description": "Validation Error",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/HTTPValidationError"
                }
              }
            }
          }
        }
      }
    },
    "/v1/test/purchases": {
      "post": {
        "tags": [
          "simulator"
        ],
        "summary": "Simulate a wallet purchase",
        "description": "Resolves the token to its card, sends an authorization with a new trace_id and token_requestor WALLET, and returns the bank's decision (plus trace_id).",
        "operationId": "purchase_v1_test_purchases_post",
        "requestBody": {
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/PurchaseRequest"
              }
            }
          },
          "required": true
        },
        "responses": {
          "200": {
            "description": "Successful Response",
            "content": {
              "application/json": {
                "schema": {}
              }
            }
          },
          "422": {
            "description": "Validation Error",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/HTTPValidationError"
                }
              }
            }
          }
        }
      }
    },
    "/v1/test/card-purchases": {
      "post": {
        "tags": [
          "simulator"
        ],
        "summary": "Simulate a plain card purchase",
        "description": "Charges the card directly (token_requestor CARD, no token). This is how an unused card becomes recently used and so eligible for the wallet.",
        "operationId": "card_purchase_v1_test_card_purchases_post",
        "requestBody": {
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/CardPurchaseRequest"
              }
            }
          },
          "required": true
        },
        "responses": {
          "200": {
            "description": "Successful Response",
            "content": {
              "application/json": {
                "schema": {}
              }
            }
          },
          "422": {
            "description": "Validation Error",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/HTTPValidationError"
                }
              }
            }
          }
        }
      }
    },
    "/v1/test/purchases/{trace_id}/settle": {
      "post": {
        "tags": [
          "simulator"
        ],
        "summary": "Settle a purchase (clearing)",
        "operationId": "settle_v1_test_purchases__trace_id__settle_post",
        "parameters": [
          {
            "name": "trace_id",
            "in": "path",
            "required": true,
            "schema": {
              "type": "string",
              "description": "trace_id returned by a purchase",
              "title": "Trace Id"
            },
            "description": "trace_id returned by a purchase"
          }
        ],
        "requestBody": {
          "content": {
            "application/json": {
              "schema": {
                "anyOf": [
                  {
                    "$ref": "#/components/schemas/ClearingAmount"
                  },
                  {
                    "type": "null"
                  }
                ],
                "title": "Body"
              }
            }
          }
        },
        "responses": {
          "200": {
            "description": "Successful Response",
            "content": {
              "application/json": {
                "schema": {}
              }
            }
          },
          "422": {
            "description": "Validation Error",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/HTTPValidationError"
                }
              }
            }
          }
        }
      }
    },
    "/v1/test/purchases/{trace_id}/reverse": {
      "post": {
        "tags": [
          "simulator"
        ],
        "summary": "Reverse all or part of a purchase",
        "operationId": "reverse_v1_test_purchases__trace_id__reverse_post",
        "parameters": [
          {
            "name": "trace_id",
            "in": "path",
            "required": true,
            "schema": {
              "type": "string",
              "description": "trace_id returned by a purchase",
              "title": "Trace Id"
            },
            "description": "trace_id returned by a purchase"
          }
        ],
        "requestBody": {
          "content": {
            "application/json": {
              "schema": {
                "anyOf": [
                  {
                    "$ref": "#/components/schemas/ClearingAmount"
                  },
                  {
                    "type": "null"
                  }
                ],
                "title": "Body"
              }
            }
          }
        },
        "responses": {
          "200": {
            "description": "Successful Response",
            "content": {
              "application/json": {
                "schema": {}
              }
            }
          },
          "422": {
            "description": "Validation Error",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/HTTPValidationError"
                }
              }
            }
          }
        }
      }
    },
    "/v1/test/purchases/{trace_id}/refund": {
      "post": {
        "tags": [
          "simulator"
        ],
        "summary": "Refund part or all of a settled purchase",
        "operationId": "refund_v1_test_purchases__trace_id__refund_post",
        "parameters": [
          {
            "name": "trace_id",
            "in": "path",
            "required": true,
            "schema": {
              "type": "string",
              "description": "trace_id returned by a purchase",
              "title": "Trace Id"
            },
            "description": "trace_id returned by a purchase"
          }
        ],
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/RefundAmount"
              }
            }
          }
        },
        "responses": {
          "200": {
            "description": "Successful Response",
            "content": {
              "application/json": {
                "schema": {}
              }
            }
          },
          "422": {
            "description": "Validation Error",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/HTTPValidationError"
                }
              }
            }
          }
        }
      }
    },
    "/test/behaviour": {
      "get": {
        "tags": [
          "test-support"
        ],
        "summary": "Read the active controls",
        "operationId": "get_behaviour_test_behaviour_get",
        "responses": {
          "200": {
            "description": "Successful Response",
            "content": {
              "application/json": {
                "schema": {
                  "additionalProperties": true,
                  "type": "object",
                  "title": "Response Get Behaviour Test Behaviour Get"
                }
              }
            }
          }
        }
      },
      "post": {
        "tags": [
          "test-support"
        ],
        "summary": "Replace the active controls",
        "operationId": "set_behaviour_test_behaviour_post",
        "requestBody": {
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/BehaviourRequest"
              }
            }
          },
          "required": true
        },
        "responses": {
          "200": {
            "description": "Successful Response",
            "content": {
              "application/json": {
                "schema": {
                  "additionalProperties": true,
                  "type": "object",
                  "title": "Response Set Behaviour Test Behaviour Post"
                }
              }
            }
          },
          "422": {
            "description": "Validation Error",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/HTTPValidationError"
                }
              }
            }
          }
        }
      }
    },
    "/test/state": {
      "get": {
        "tags": [
          "test-support"
        ],
        "summary": "Tokens and purchases the network knows",
        "operationId": "get_state_test_state_get",
        "responses": {
          "200": {
            "description": "Successful Response",
            "content": {
              "application/json": {
                "schema": {
                  "additionalProperties": true,
                  "type": "object",
                  "title": "Response Get State Test State Get"
                }
              }
            }
          }
        }
      }
    },
    "/test/reset": {
      "post": {
        "tags": [
          "test-support"
        ],
        "summary": "Reset this service",
        "description": "Truncates this service's tables, clears faults, idempotency keys and lockouts, and skips consumers to the end of their topics.",
        "operationId": "reset_test_reset_post",
        "responses": {
          "200": {
            "description": "Successful Response",
            "content": {
              "application/json": {
                "schema": {
                  "additionalProperties": true,
                  "type": "object",
                  "title": "Response Reset Test Reset Post"
                }
              }
            }
          }
        }
      }
    },
    "/test/seed": {
      "post": {
        "tags": [
          "test-support"
        ],
        "summary": "Load seed data",
        "description": "Resets this service, then writes the deterministic seed data.",
        "operationId": "seed_test_seed_post",
        "responses": {
          "200": {
            "description": "Successful Response",
            "content": {
              "application/json": {
                "schema": {
                  "additionalProperties": true,
                  "type": "object",
                  "title": "Response Seed Test Seed Post"
                }
              }
            }
          }
        }
      }
    },
    "/test/faults": {
      "get": {
        "tags": [
          "test-support"
        ],
        "summary": "List active faults",
        "operationId": "get_faults_test_faults_get",
        "responses": {
          "200": {
            "description": "Successful Response",
            "content": {
              "application/json": {
                "schema": {
                  "additionalProperties": true,
                  "type": "object",
                  "title": "Response Get Faults Test Faults Get"
                }
              }
            }
          }
        }
      },
      "post": {
        "tags": [
          "test-support"
        ],
        "summary": "Replace the active fault set",
        "operationId": "set_faults_test_faults_post",
        "requestBody": {
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/FaultsRequest"
              }
            }
          },
          "required": true
        },
        "responses": {
          "200": {
            "description": "Successful Response",
            "content": {
              "application/json": {
                "schema": {
                  "additionalProperties": true,
                  "type": "object",
                  "title": "Response Set Faults Test Faults Post"
                }
              }
            }
          },
          "422": {
            "description": "Validation Error",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/HTTPValidationError"
                }
              }
            }
          }
        }
      }
    },
    "/test/clock": {
      "get": {
        "tags": [
          "test-support"
        ],
        "summary": "Read the effective time",
        "operationId": "get_clock_test_clock_get",
        "responses": {
          "200": {
            "description": "Successful Response",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ClockView"
                }
              }
            }
          }
        }
      },
      "post": {
        "tags": [
          "test-support"
        ],
        "summary": "Move the shared clock",
        "description": "Writes the single shared offset row. Returns once this service sees the new time; other services follow within 1 second.",
        "operationId": "set_clock_test_clock_post",
        "requestBody": {
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/ClockRequest"
              }
            }
          },
          "required": true
        },
        "responses": {
          "200": {
            "description": "Successful Response",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ClockView"
                }
              }
            }
          },
          "422": {
            "description": "Validation Error",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/HTTPValidationError"
                }
              }
            }
          }
        }
      }
    },
    "/test/quiet": {
      "get": {
        "tags": [
          "test-support"
        ],
        "summary": "Is anything in flight?",
        "description": "Outbox depth and consumer lag. quiet=true when both are zero.",
        "operationId": "quiet_test_quiet_get",
        "responses": {
          "200": {
            "description": "Successful Response",
            "content": {
              "application/json": {
                "schema": {
                  "additionalProperties": true,
                  "type": "object",
                  "title": "Response Quiet Test Quiet Get"
                }
              }
            }
          }
        }
      }
    },
    "/test/bugs": {
      "get": {
        "tags": [
          "test-support"
        ],
        "summary": "Seeded-bug flags that are on in this service",
        "operationId": "active_bugs_test_bugs_get",
        "responses": {
          "200": {
            "description": "Successful Response",
            "content": {
              "application/json": {
                "schema": {
                  "additionalProperties": true,
                  "type": "object",
                  "title": "Response Active Bugs Test Bugs Get"
                }
              }
            }
          }
        }
      }
    }
  },
  "components": {
    "schemas": {
      "BehaviourRequest": {
        "properties": {
          "controls": {
            "items": {
              "$ref": "#/components/schemas/ControlSpec"
            },
            "type": "array",
            "title": "Controls"
          }
        },
        "type": "object",
        "title": "BehaviourRequest",
        "description": "Replaces every control. ``{\"controls\": []}`` turns them all off."
      },
      "CardPurchaseRequest": {
        "properties": {
          "card_id": {
            "type": "string",
            "format": "uuid",
            "title": "Card Id",
            "description": "Card to charge directly (no wallet token)"
          },
          "amount": {
            "type": "integer",
            "title": "Amount"
          },
          "merchant_name": {
            "type": "string",
            "title": "Merchant Name",
            "default": "CardVault Test Merchant"
          },
          "mcc": {
            "type": "string",
            "title": "Mcc",
            "default": "5999"
          },
          "currency": {
            "type": "string",
            "title": "Currency",
            "default": "USD"
          }
        },
        "type": "object",
        "required": [
          "card_id",
          "amount"
        ],
        "title": "CardPurchaseRequest"
      },
      "ClearingAmount": {
        "properties": {
          "amount": {
            "anyOf": [
              {
                "type": "integer"
              },
              {
                "type": "null"
              }
            ],
            "title": "Amount",
            "description": "Cents. Default: the authorized amount"
          }
        },
        "type": "object",
        "title": "ClearingAmount"
      },
      "ClockRequest": {
        "properties": {
          "offset_seconds": {
            "anyOf": [
              {
                "type": "number"
              },
              {
                "type": "null"
              }
            ],
            "title": "Offset Seconds",
            "description": "Set the offset from real time"
          },
          "advance_seconds": {
            "anyOf": [
              {
                "type": "number"
              },
              {
                "type": "null"
              }
            ],
            "title": "Advance Seconds",
            "description": "Move the clock by this much"
          },
          "now": {
            "anyOf": [
              {
                "type": "string",
                "format": "date-time"
              },
              {
                "type": "null"
              }
            ],
            "title": "Now",
            "description": "Set the effective time (timezone-aware)"
          },
          "reset": {
            "anyOf": [
              {
                "type": "boolean"
              },
              {
                "type": "null"
              }
            ],
            "title": "Reset",
            "description": "true clears the offset (real time)"
          }
        },
        "type": "object",
        "title": "ClockRequest",
        "description": "Exactly one of the fields. The offset applies to every service at once."
      },
      "ClockView": {
        "properties": {
          "now": {
            "type": "string",
            "format": "date-time",
            "title": "Now"
          },
          "real_now": {
            "type": "string",
            "format": "date-time",
            "title": "Real Now"
          },
          "offset_seconds": {
            "type": "number",
            "title": "Offset Seconds"
          },
          "service": {
            "type": "string",
            "title": "Service"
          }
        },
        "type": "object",
        "required": [
          "now",
          "real_now",
          "offset_seconds",
          "service"
        ],
        "title": "ClockView"
      },
      "ControlSpec": {
        "properties": {
          "type": {
            "type": "string",
            "enum": [
              "duplicate_authorization",
              "timeout_retry",
              "clearing_before_auth_event"
            ],
            "title": "Type"
          },
          "scope": {
            "$ref": "#/components/schemas/FaultScope"
          },
          "fail_next": {
            "anyOf": [
              {
                "type": "integer",
                "minimum": 1.0
              },
              {
                "type": "null"
              }
            ],
            "title": "Fail Next",
            "description": "Apply to the next N purchases only"
          },
          "rate": {
            "anyOf": [
              {
                "type": "number",
                "maximum": 1.0,
                "exclusiveMinimum": 0.0
              },
              {
                "type": "null"
              }
            ],
            "title": "Rate",
            "description": "Probability per purchase"
          },
          "seed": {
            "anyOf": [
              {
                "type": "integer"
              },
              {
                "type": "null"
              }
            ],
            "title": "Seed",
            "description": "RNG seed for rate mode"
          }
        },
        "type": "object",
        "required": [
          "type"
        ],
        "title": "ControlSpec",
        "description": "One control. Without fail_next or rate it applies to every purchase until reset."
      },
      "ErrorBody": {
        "properties": {
          "error_code": {
            "type": "string",
            "title": "Error Code"
          },
          "message": {
            "type": "string",
            "title": "Message"
          },
          "correlation_id": {
            "anyOf": [
              {
                "type": "string"
              },
              {
                "type": "null"
              }
            ],
            "title": "Correlation Id"
          },
          "details": {
            "anyOf": [
              {},
              {
                "type": "null"
              }
            ],
            "title": "Details"
          }
        },
        "type": "object",
        "required": [
          "error_code",
          "message",
          "correlation_id"
        ],
        "title": "ErrorBody",
        "description": "The common error response body."
      },
      "FaultScope": {
        "properties": {
          "method": {
            "anyOf": [
              {
                "type": "string"
              },
              {
                "type": "null"
              }
            ],
            "title": "Method",
            "description": "HTTP method to match, e.g. POST"
          },
          "path": {
            "anyOf": [
              {
                "type": "string"
              },
              {
                "type": "null"
              }
            ],
            "title": "Path",
            "description": "Exact path, or a prefix ending in *"
          },
          "topic": {
            "anyOf": [
              {
                "type": "string"
              },
              {
                "type": "null"
              }
            ],
            "title": "Topic",
            "description": "Kafka topic, for Kafka faults"
          }
        },
        "type": "object",
        "title": "FaultScope"
      },
      "FaultSpec": {
        "properties": {
          "type": {
            "type": "string",
            "enum": [
              "latency",
              "error",
              "timeout",
              "kafka_publish_failure",
              "consumer_pause",
              "relay_pause"
            ],
            "title": "Type"
          },
          "scope": {
            "$ref": "#/components/schemas/FaultScope"
          },
          "fail_next": {
            "anyOf": [
              {
                "type": "integer",
                "minimum": 1.0
              },
              {
                "type": "null"
              }
            ],
            "title": "Fail Next",
            "description": "Fire on the next N matches only"
          },
          "rate": {
            "anyOf": [
              {
                "type": "number",
                "maximum": 1.0,
                "exclusiveMinimum": 0.0
              },
              {
                "type": "null"
              }
            ],
            "title": "Rate",
            "description": "Probability of firing per match"
          },
          "seed": {
            "anyOf": [
              {
                "type": "integer"
              },
              {
                "type": "null"
              }
            ],
            "title": "Seed",
            "description": "RNG seed for rate mode (deterministic runs)"
          },
          "latency_ms": {
            "type": "integer",
            "maximum": 120000.0,
            "minimum": 0.0,
            "title": "Latency Ms",
            "default": 0
          },
          "status": {
            "type": "integer",
            "maximum": 599.0,
            "minimum": 500.0,
            "title": "Status",
            "description": "Status for the error fault",
            "default": 503
          },
          "timeout_ms": {
            "type": "integer",
            "maximum": 300000.0,
            "minimum": 0.0,
            "title": "Timeout Ms",
            "default": 30000
          }
        },
        "type": "object",
        "required": [
          "type"
        ],
        "title": "FaultSpec",
        "description": "One fault. See the module docs for the meaning of each field."
      },
      "FaultsRequest": {
        "properties": {
          "faults": {
            "items": {
              "$ref": "#/components/schemas/FaultSpec"
            },
            "type": "array",
            "title": "Faults"
          }
        },
        "type": "object",
        "title": "FaultsRequest",
        "description": "Replaces the whole active fault set. ``{\"faults\": []}`` clears every fault."
      },
      "HTTPValidationError": {
        "properties": {
          "detail": {
            "items": {
              "$ref": "#/components/schemas/ValidationError"
            },
            "type": "array",
            "title": "Detail"
          }
        },
        "type": "object",
        "title": "HTTPValidationError"
      },
      "PurchaseRequest": {
        "properties": {
          "token_ref": {
            "type": "string",
            "maxLength": 64,
            "minLength": 1,
            "title": "Token Ref",
            "description": "Wallet token to charge"
          },
          "amount": {
            "type": "integer",
            "title": "Amount",
            "description": "Cents. Not validated here, so tests can send bad values"
          },
          "merchant_name": {
            "type": "string",
            "title": "Merchant Name",
            "description": "Untrusted free text",
            "default": "CardVault Test Merchant"
          },
          "mcc": {
            "type": "string",
            "title": "Mcc",
            "description": "Merchant category code",
            "default": "5999"
          },
          "currency": {
            "type": "string",
            "title": "Currency",
            "default": "USD"
          }
        },
        "type": "object",
        "required": [
          "token_ref",
          "amount"
        ],
        "title": "PurchaseRequest"
      },
      "RefundAmount": {
        "properties": {
          "amount": {
            "type": "integer",
            "title": "Amount",
            "description": "Cents to refund"
          }
        },
        "type": "object",
        "required": [
          "amount"
        ],
        "title": "RefundAmount"
      },
      "TokenRequest": {
        "properties": {
          "card_id": {
            "type": "string",
            "format": "uuid",
            "title": "Card Id",
            "description": "The bank's card_id (never a card number)"
          },
          "enrollment_id": {
            "anyOf": [
              {
                "type": "string",
                "format": "uuid"
              },
              {
                "type": "null"
              }
            ],
            "title": "Enrollment Id",
            "description": "The bank's enrolment ID"
          }
        },
        "type": "object",
        "required": [
          "card_id"
        ],
        "title": "TokenRequest"
      },
      "TokenResponse": {
        "properties": {
          "token_ref": {
            "type": "string",
            "title": "Token Ref"
          },
          "card_id": {
            "type": "string",
            "format": "uuid",
            "title": "Card Id"
          }
        },
        "type": "object",
        "required": [
          "token_ref",
          "card_id"
        ],
        "title": "TokenResponse"
      },
      "ValidationError": {
        "properties": {
          "loc": {
            "items": {
              "anyOf": [
                {
                  "type": "string"
                },
                {
                  "type": "integer"
                }
              ]
            },
            "type": "array",
            "title": "Location"
          },
          "msg": {
            "type": "string",
            "title": "Message"
          },
          "type": {
            "type": "string",
            "title": "Error Type"
          },
          "input": {
            "title": "Input"
          },
          "ctx": {
            "type": "object",
            "title": "Context"
          }
        },
        "type": "object",
        "required": [
          "loc",
          "msg",
          "type"
        ],
        "title": "ValidationError"
      }
    }
  }
}