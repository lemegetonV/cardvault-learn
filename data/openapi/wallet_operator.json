  "components": {
    "schemas": {
      "BehaviourRequest": {
        "properties": {
          "controls": {
            "items": {
              "$ref": "#/components/schemas/ControlSpec"
            },
            "type": "array",
            "title": "Controls"
          }
        },
        "type": "object",
        "title": "BehaviourRequest",
        "description": "Replaces every control. ``{\"controls\": []}`` turns them all off."
      },
      "ClockRequest": {
        "properties": {
          "offset_seconds": {
            "anyOf": [
              {
                "type": "number"
              },
              {
                "type": "null"
              }
            ],
            "title": "Offset Seconds",
            "description": "Set the offset from real time"
          },
          "advance_seconds": {
            "anyOf": [
              {
                "type": "number"
              },
              {
                "type": "null"
              }
            ],
            "title": "Advance Seconds",
            "description": "Move the clock by this much"
          },
          "now": {
            "anyOf": [
              {
                "type": "string",
                "format": "date-time"
              },
              {
                "type": "null"
              }
            ],
            "title": "Now",
            "description": "Set the effective time (timezone-aware)"
          },
          "reset": {
            "anyOf": [
              {
                "type": "boolean"
              },
              {
                "type": "null"
              }
            ],
            "title": "Reset",
            "description": "true clears the offset (real time)"
          }
        },
        "type": "object",
        "title": "ClockRequest",
        "description": "Exactly one of the fields. The offset applies to every service at once."
      },
      "ClockView": {
        "properties": {
          "now": {
            "type": "string",
            "format": "date-time",
            "title": "Now"
          },
          "real_now": {
            "type": "string",
            "format": "date-time",
            "title": "Real Now"
          },
          "offset_seconds": {
            "type": "number",
            "title": "Offset Seconds"
          },
          "service": {
            "type": "string",
            "title": "Service"
          }
        },
        "type": "object",
        "required": [
          "now",
          "real_now",
          "offset_seconds",
          "service"
        ],
        "title": "ClockView"
      },
      "ControlSpec": {
        "properties": {
          "type": {
            "type": "string",
            "enum": [
              "callback_delay",
              "error",
              "timeout",
              "duplicate_callback",
              "out_of_order_callback",
              "bad_signature",
              "drop_callback",
              "decline_enrollment"
            ],
            "title": "Type"
          },
          "scope": {
            "$ref": "#/components/schemas/FaultScope"
          },
          "fail_next": {
            "anyOf": [
              {
                "type": "integer",
                "minimum": 1.0
              },
              {
                "type": "null"
              }
            ],
            "title": "Fail Next",
            "description": "Apply to the next N requests only"
          },
          "rate": {
            "anyOf": [
              {
                "type": "number",
                "maximum": 1.0,
                "exclusiveMinimum": 0.0
              },
              {
                "type": "null"
              }
            ],
            "title": "Rate",
            "description": "Probability per request"
          },
          "seed": {
            "anyOf": [
              {
                "type": "integer"
              },
              {
                "type": "null"
              }
            ],
            "title": "Seed",
            "description": "RNG seed for rate mode"
          },
          "delay_ms": {
            "type": "integer",
            "maximum": 120000.0,
            "minimum": 0.0,
            "title": "Delay Ms",
            "description": "callback_delay",
            "default": 2000
          },
          "status": {
            "type": "integer",
            "maximum": 599.0,
            "minimum": 500.0,
            "title": "Status",
            "description": "error: the status to return",
            "default": 503
          },
          "timeout_ms": {
            "type": "integer",
            "maximum": 120000.0,
            "minimum": 0.0,
            "title": "Timeout Ms",
            "description": "timeout: how long to hang",
            "default": 10000
          },
          "reason": {
            "type": "string",
            "maxLength": 100,
            "title": "Reason",
            "description": "decline reason",
            "default": "DECLINED_BY_OPERATOR"
          }
        },
        "type": "object",
        "required": [
          "type"
        ],
        "title": "ControlSpec",
        "description": "One control. Without fail_next or rate it applies every time until reset."
      },
      "ErrorBody": {
        "properties": {
          "error_code": {
            "type": "string",
            "title": "Error Code"
          },
          "message": {
            "type": "string",
            "title": "Message"
          },
          "correlation_id": {
            "anyOf": [
              {
                "type": "string"
              },
              {
                "type": "null"
              }
            ],
            "title": "Correlation Id"
          },
          "details": {
            "anyOf": [
              {},
              {
                "type": "null"
              }
            ],
            "title": "Details"
          }
        },
        "type": "object",
        "required": [
          "error_code",
          "message",
          "correlation_id"
        ],
        "title": "ErrorBody",
        "description": "The common error response body."
      },
      "FaultScope": {
        "properties": {
          "method": {
            "anyOf": [
              {
                "type": "string"
              },
              {
                "type": "null"
              }
            ],
            "title": "Method",
            "description": "HTTP method to match, e.g. POST"
          },
          "path": {
            "anyOf": [
              {
                "type": "string"
              },
              {
                "type": "null"
              }
            ],
            "title": "Path",
            "description": "Exact path, or a prefix ending in *"
          },
          "topic": {
            "anyOf": [
              {
                "type": "string"
              },
              {
                "type": "null"
              }
            ],
            "title": "Topic",
            "description": "Kafka topic, for Kafka faults"
          }
        },
        "type": "object",
        "title": "FaultScope"
      },
      "FaultSpec": {
        "properties": {
          "type": {
            "type": "string",
            "enum": [
              "latency",
              "error",
              "timeout",
              "kafka_publish_failure",
              "consumer_pause",
              "relay_pause"
            ],
            "title": "Type"
          },
          "scope": {
            "$ref": "#/components/schemas/FaultScope"
          },
          "fail_next": {
            "anyOf": [
              {
                "type": "integer",
                "minimum": 1.0
              },
              {
                "type": "null"
              }
            ],
            "title": "Fail Next",
            "description": "Fire on the next N matches only"
          },
          "rate": {
            "anyOf": [
              {
                "type": "number",
                "maximum": 1.0,
                "exclusiveMinimum": 0.0
              },
              {
                "type": "null"
              }
            ],
            "title": "Rate",
            "description": "Probability of firing per match"
          },
          "seed": {
            "anyOf": [
              {
                "type": "integer"
              },
              {
                "type": "null"
              }
            ],
            "title": "Seed",
            "description": "RNG seed for rate mode (deterministic runs)"
          },
          "latency_ms": {
            "type": "integer",
            "maximum": 120000.0,
            "minimum": 0.0,
            "title": "Latency Ms",
            "default": 0
          },
          "status": {
            "type": "integer",
            "maximum": 599.0,
            "minimum": 500.0,
            "title": "Status",
            "description": "Status for the error fault",
            "default": 503
          },
          "timeout_ms": {
            "type": "integer",
            "maximum": 300000.0,
            "minimum": 0.0,
            "title": "Timeout Ms",
            "default": 30000
          }
        },
        "type": "object",
        "required": [
          "type"
        ],
        "title": "FaultSpec",
        "description": "One fault. See the module docs for the meaning of each field."
      },
      "FaultsRequest": {
        "properties": {
          "faults": {
            "items": {
              "$ref": "#/components/schemas/FaultSpec"
            },
            "type": "array",
            "title": "Faults"
          }
        },
        "type": "object",
        "title": "FaultsRequest",
        "description": "Replaces the whole active fault set. ``{\"faults\": []}`` clears every fault."
      },
      "HTTPValidationError": {
        "properties": {
          "detail": {
            "items": {
              "$ref": "#/components/schemas/ValidationError"
            },
            "type": "array",
            "title": "Detail"
          }
        },
        "type": "object",
        "title": "HTTPValidationError"
      },
      "RecordPatch": {
        "properties": {
          "enrollment_id": {
            "type": "string",
            "format": "uuid",
            "title": "Enrollment Id"
          },
          "operator_ref": {
            "anyOf": [
              {
                "type": "string"
              },
              {
                "type": "null"
              }
            ],
            "title": "Operator Ref"
          },
          "card_id": {
            "anyOf": [
              {
                "type": "string",
                "format": "uuid"
              },
              {
                "type": "null"
              }
            ],
            "title": "Card Id"
          },
          "token_ref": {
            "anyOf": [
              {
                "type": "string"
              },
              {
                "type": "null"
              }
            ],
            "title": "Token Ref"
          },
          "status": {
            "anyOf": [
              {
                "type": "string",
                "enum": [
                  "PROCESSING",
                  "ENROLLED",
                  "SUSPENDED",
                  "REMOVED",
                  "FAILED"
                ]
              },
              {
                "type": "null"
              }
            ],
            "title": "Status"
          },
          "last4": {
            "anyOf": [
              {
                "type": "string",
                "pattern": "^\\d{4}$"
              },
              {
                "type": "null"
              }
            ],
            "title": "Last4"
          },
          "expiry": {
            "anyOf": [
              {
                "type": "string",
                "pattern": "^\\d{4}-\\d{2}$"
              },
              {
                "type": "null"
              }
            ],
            "title": "Expiry"
          },
          "operator_version": {
            "anyOf": [
              {
                "type": "integer",
                "minimum": 0.0
              },
              {
                "type": "null"
              }
            ],
            "title": "Operator Version"
          }
        },
        "type": "object",
        "required": [
          "enrollment_id"
        ],
        "title": "RecordPatch"
      },
      "StateChange": {
        "properties": {
          "upsert": {
            "items": {
              "$ref": "#/components/schemas/RecordPatch"
            },
            "type": "array",
            "title": "Upsert"
          },
          "delete": {
            "items": {
              "type": "string",
              "format": "uuid"
            },
            "type": "array",
            "title": "Delete",
            "description": "enrollment_ids"
          }
        },
        "type": "object",
        "title": "StateChange",
        "description": "Make the operator's records differ from the bank's (for reconciliation), or add one."
      },
      "ValidationError": {
        "properties": {
          "loc": {
            "items": {
              "anyOf": [
                {
                  "type": "string"
                },
                {
                  "type": "integer"
                }
              ]
            },
            "type": "array",
            "title": "Location"
          },
          "msg": {
            "type": "string",
            "title": "Message"
          },
          "type": {
            "type": "string",
            "title": "Error Type"
          },
          "input": {
            "title": "Input"
          },
          "ctx": {
            "type": "object",
            "title": "Context"
          }
        },
        "type": "object",
        "required": [
          "loc",
          "msg",
          "type"
        ],
        "title": "ValidationError"
      }
    }
  }
}