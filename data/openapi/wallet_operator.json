{
  "openapi": "3.1.0",
  "info": {
    "title": "CardVault wallet-operator-mock",
    "description": "A controllable stand-in for the wallet operator: accepts enrolment requests from the bank (202), gets tokens from the network, sends signed status callbacks, and serves the daily enrolment file, the embeddable terms page and the help page.",
    "version": "0.1.0"
  },
