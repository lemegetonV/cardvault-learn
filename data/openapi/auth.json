{
  "openapi": "3.1.0",
  "info": {
    "title": "CardVault auth-service",
    "description": "Customer authentication for CardVault Bank: login with lockout, RS256 access tokens (15 min), rotating refresh tokens (7 days) and the JWKS other services use to verify tokens themselves.",
    "version": "0.1.0"
  },
  "paths": {
    "/health": {
      "get": {
        "tags": [
          "health"
        ],
        "summary": "Liveness",
        "description": "200 while the process is up.",
        "operationId": "health_health_get",
        "responses": {
          "200": {
            "description": "Successful Response",
            "content": {
              "application/json": {
                "schema": {
                  "additionalProperties": true,
                  "type": "object",
                  "title": "Response Health Health Get"
                }
              }
            }
          }
        }
      }
    },
    "/ready": {
      "get": {
        "tags": [
          "health"
        ],
        "summary": "Readiness",
        "description": "200 when the service's database (and Kafka, if it uses Kafka) answer.",
        "operationId": "ready_ready_get",
        "responses": {
          "200": {
            "description": "Successful Response",
            "content": {
              "application/json": {
                "schema": {}
              }
            }
          },
          "503": {
            "description": "A dependency is not reachable"
          }
        }
      }
    },
    "/v1/auth/login": {
      "post": {
        "tags": [
          "auth"
        ],
        "summary": "Log in",
        "description": "Exchanges a username and password for a 15-minute access token and a 7-day refresh token. Five failed attempts for a username (known or not) lock it for 15 minutes (423 ACCOUNT_LOCKED). Unknown usernames and wrong passwords both return 401 INVALID_CREDENTIALS, so the response does not reveal which usernames exist.",
        "operationId": "login_v1_auth_login_post",
        "requestBody": {
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/LoginRequest"
              }
            }
          },
          "required": true
        },
        "responses": {
          "200": {
            "description": "Successful Response",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/TokenResponse"
                }
              }
            }
          },
          "401": {
            "description": "Unauthorized",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ErrorBody"
                }
              }
            }
          },
          "422": {
            "description": "Unprocessable Entity",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ErrorBody"
                }
              }
            }
          },
          "423": {
            "description": "Account locked",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ErrorBody"
                }
              }
            }
          }
        }
      }
    },
    "/v1/auth/refresh": {
      "post": {
        "tags": [
          "auth"
        ],
        "summary": "Refresh tokens",
        "description": "Exchanges a refresh token for a new access token and a new refresh token. The old refresh token stops working. Presenting an already-used refresh token is treated as theft: the whole token family is revoked (401 REFRESH_TOKEN_REUSED).",
        "operationId": "refresh_v1_auth_refresh_post",
        "requestBody": {
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/RefreshRequest"
              }
            }
          },
          "required": true
        },
        "responses": {
          "200": {
            "description": "Successful Response",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/TokenResponse"
                }
              }
            }
          },
          "401": {
            "description": "Unauthorized",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ErrorBody"
                }
              }
            }
          },
          "422": {
            "description": "Unprocessable Entity",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ErrorBody"
                }
              }
            }
          }
        }
      }
    },
    "/v1/auth/logout": {
      "post": {
        "tags": [
          "auth"
        ],
        "summary": "Log out",
        "description": "Revokes the refresh token and every token in its family. Always 204, even for an unknown token, so the endpoint cannot be used to test tokens. The access token stays valid until it expires (at most 15 minutes).",
        "operationId": "logout_v1_auth_logout_post",
        "requestBody": {
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/RefreshRequest"
              }
            }
          },
          "required": true
        },
        "responses": {
          "204": {
            "description": "Successful Response"
          },
          "422": {
            "description": "Unprocessable Entity",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ErrorBody"
                }
              }
            }
          }
        }
      }
    },
    "/v1/auth/me": {
      "get": {
        "tags": [
          "auth"
        ],
        "summary": "Who am I",
        "description": "Returns the customer identified by the bearer access token.",
        "operationId": "me_v1_auth_me_get",
        "responses": {
          "200": {
            "description": "Successful Response",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/MeResponse"
                }
              }
            }
          },
          "401": {
            "description": "Unauthorized",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ErrorBody"
                }
              }
            }
          }
        }
      }
    },
    "/.well-known/jwks.json": {
      "get": {
        "tags": [
          "auth",
          "auth"
        ],
        "summary": "JSON Web Key Set",
        "description": "Public keys for verifying access tokens. Services cache it by kid.",
        "operationId": "jwks__well_known_jwks_json_get",
        "responses": {
          "200": {
            "description": "Successful Response",
            "content": {
              "application/json": {
                "schema": {
                  "additionalProperties": true,
                  "type": "object",
                  "title": "Response Jwks  Well Known Jwks Json Get"
                }
              }
            }
          }
        }
      }
    },
    "/test/reset": {
      "post": {
        "tags": [
          "test-support"
        ],
        "summary": "Reset this service",
        "description": "Truncates this service's tables, clears faults, idempotency keys and lockouts, and skips consumers to the end of their topics.",
        "operationId": "reset_test_reset_post",
        "responses": {
          "200": {
            "description": "Successful Response",
            "content": {
              "application/json": {
                "schema": {
                  "additionalProperties": true,
                  "type": "object",
                  "title": "Response Reset Test Reset Post"
                }
              }
            }
          }
        }
      }
    },
    "/test/seed": {
      "post": {
        "tags": [
          "test-support"
        ],
        "summary": "Load seed data",
        "description": "Resets this service, then writes the deterministic seed data.",
        "operationId": "seed_test_seed_post",
        "responses": {
          "200": {
            "description": "Successful Response",
            "content": {
              "application/json": {
                "schema": {
                  "additionalProperties": true,
                  "type": "object",
                  "title": "Response Seed Test Seed Post"
                }
              }
            }
          }
        }
      }
    },
    "/test/faults": {
      "get": {
        "tags": [
          "test-support"
        ],
        "summary": "List active faults",
        "operationId": "get_faults_test_faults_get",
        "responses": {
          "200": {
            "description": "Successful Response",
            "content": {
              "application/json": {
                "schema": {
                  "additionalProperties": true,
                  "type": "object",
                  "title": "Response Get Faults Test Faults Get"
                }
              }
            }
          }
        }
      },
      "post": {
        "tags": [
          "test-support"
        ],
        "summary": "Replace the active fault set",
        "operationId": "set_faults_test_faults_post",
        "requestBody": {
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/FaultsRequest"
              }
            }
          },
          "required": true
        },
        "responses": {
          "200": {
            "description": "Successful Response",
            "content": {
              "application/json": {
                "schema": {
                  "additionalProperties": true,
                  "type": "object",
                  "title": "Response Set Faults Test Faults Post"
                }
              }
            }
          },
          "422": {
            "description": "Validation Error",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/HTTPValidationError"
                }
              }
            }
          }
        }
      }
    },
    "/test/clock": {
      "get": {
        "tags": [
          "test-support"
        ],
        "summary": "Read the effective time",
        "operationId": "get_clock_test_clock_get",
        "responses": {
          "200": {
            "description": "Successful Response",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ClockView"
                }
              }
            }
          }
        }
      },
      "post": {
        "tags": [
          "test-support"
        ],
        "summary": "Move the shared clock",
        "description": "Writes the single shared offset row. Returns once this service sees the new time; other services follow within 1 second.",
        "operationId": "set_clock_test_clock_post",
        "requestBody": {
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/ClockRequest"
              }
            }
          },
          "required": true
        },
        "responses": {
          "200": {
            "description": "Successful Response",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ClockView"
                }
              }
            }
          },
          "422": {
            "description": "Validation Error",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/HTTPValidationError"
                }
              }
            }
          }
        }
      }
    },
    "/test/quiet": {
      "get": {
        "tags": [
          "test-support"
        ],
        "summary": "Is anything in flight?",
        "description": "Outbox depth and consumer lag. quiet=true when both are zero.",
        "operationId": "quiet_test_quiet_get",
        "responses": {
          "200": {
            "description": "Successful Response",
            "content": {
              "application/json": {
                "schema": {
                  "additionalProperties": true,
                  "type": "object",
                  "title": "Response Quiet Test Quiet Get"
                }
              }
            }
          }
        }
      }
    },
    "/test/bugs": {
      "get": {
        "tags": [
          "test-support"
        ],
        "summary": "Seeded-bug flags that are on in this service",
        "operationId": "active_bugs_test_bugs_get",
        "responses": {
          "200": {
            "description": "Successful Response",
            "content": {
              "application/json": {
                "schema": {
                  "additionalProperties": true,
                  "type": "object",
                  "title": "Response Active Bugs Test Bugs Get"
                }
              }
            }
          }
        }
      }
    },
    "/test/users": {
      "post": {
        "tags": [
          "test-support"
        ],
        "summary": "Create a login (test support)",
        "description": "Used by the POST /test/customers orchestrator to create a fresh customer.",
        "operationId": "create_user_test_users_post",
        "requestBody": {
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/CreateUserRequest"
              }
            }
          },
          "required": true
        },
        "responses": {
          "201": {
            "description": "Successful Response",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/MeResponse"
                }
              }
            }
          },
          "422": {
            "description": "Validation Error",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/HTTPValidationError"
                }
              }
            }
          }
        }
      }
    }
  },
  "components": {
    "schemas": {
      "ClockRequest": {
        "properties": {
          "offset_seconds": {
            "anyOf": [
              {
                "type": "number"
              },
              {
                "type": "null"
              }
            ],
            "title": "Offset Seconds",
            "description": "Set the offset from real time"
          },
          "advance_seconds": {
            "anyOf": [
              {
                "type": "number"
              },
              {
                "type": "null"
              }
            ],
            "title": "Advance Seconds",
            "description": "Move the clock by this much"
          },
          "now": {
            "anyOf": [
              {
                "type": "string",
                "format": "date-time"
              },
              {
                "type": "null"
              }
            ],
            "title": "Now",
            "description": "Set the effective time (timezone-aware)"
          },
          "reset": {
            "anyOf": [
              {
                "type": "boolean"
              },
              {
                "type": "null"
              }
            ],
            "title": "Reset",
            "description": "true clears the offset (real time)"
          }
        },
        "type": "object",
        "title": "ClockRequest",
        "description": "Exactly one of the fields. The offset applies to every service at once."
      },
      "ClockView": {
        "properties": {
          "now": {
            "type": "string",
            "format": "date-time",
            "title": "Now"
          },
          "real_now": {
            "type": "string",
            "format": "date-time",
            "title": "Real Now"
          },
          "offset_seconds": {
            "type": "number",
            "title": "Offset Seconds"
          },
          "service": {
            "type": "string",
            "title": "Service"
          }
        },
        "type": "object",
        "required": [
          "now",
          "real_now",
          "offset_seconds",
          "service"
        ],
        "title": "ClockView"
      },
      "CreateUserRequest": {
        "properties": {
          "username": {
            "type": "string",
            "maxLength": 64,
            "minLength": 1,
            "title": "Username"
          },
          "password": {
            "type": "string",
            "maxLength": 256,
            "minLength": 1,
            "title": "Password"
          },
          "customer_id": {
            "anyOf": [
              {
                "type": "string",
                "format": "uuid"
              },
              {
                "type": "null"
              }
            ],
            "title": "Customer Id",
            "description": "Generated when omitted"
          },
          "display_name": {
            "anyOf": [
              {
                "type": "string",
                "maxLength": 128
              },
              {
                "type": "null"
              }
            ],
            "title": "Display Name"
          }
        },
        "type": "object",
        "required": [
          "username",
          "password"
        ],
        "title": "CreateUserRequest"
      },
      "ErrorBody": {
        "properties": {
          "error_code": {
            "type": "string",
            "title": "Error Code"
          },
          "message": {
            "type": "string",
            "title": "Message"
          },
          "correlation_id": {
            "anyOf": [
              {
                "type": "string"
              },
              {
                "type": "null"
              }
            ],
            "title": "Correlation Id"
          },
          "details": {
            "anyOf": [
              {},
              {
                "type": "null"
              }
            ],
            "title": "Details"
          }
        },
        "type": "object",
        "required": [
          "error_code",
          "message",
          "correlation_id"
        ],
        "title": "ErrorBody",
        "description": "The common error response body."
      },
      "FaultScope": {
        "properties": {
          "method": {
            "anyOf": [
              {
                "type": "string"
              },
              {
                "type": "null"
              }
            ],
            "title": "Method",
            "description": "HTTP method to match, e.g. POST"
          },
          "path": {
            "anyOf": [
              {
                "type": "string"
              },
              {
                "type": "null"
              }
            ],
            "title": "Path",
            "description": "Exact path, or a prefix ending in *"
          },
          "topic": {
            "anyOf": [
              {
                "type": "string"
              },
              {
                "type": "null"
              }
            ],
            "title": "Topic",
            "description": "Kafka topic, for Kafka faults"
          }
        },
        "type": "object",
        "title": "FaultScope"
      },
      "FaultSpec": {
        "properties": {
          "type": {
            "type": "string",
            "enum": [
              "latency",
              "error",
              "timeout",
              "kafka_publish_failure",
              "consumer_pause",
              "relay_pause"
            ],
            "title": "Type"
          },
          "scope": {
            "$ref": "#/components/schemas/FaultScope"
          },
          "fail_next": {
            "anyOf": [
              {
                "type": "integer",
                "minimum": 1.0
              },
              {
                "type": "null"
              }
            ],
            "title": "Fail Next",
            "description": "Fire on the next N matches only"
          },
          "rate": {
            "anyOf": [
              {
                "type": "number",
                "maximum": 1.0,
                "exclusiveMinimum": 0.0
              },
              {
                "type": "null"
              }
            ],
            "title": "Rate",
            "description": "Probability of firing per match"
          },
          "seed": {
            "anyOf": [
              {
                "type": "integer"
              },
              {
                "type": "null"
              }
            ],
            "title": "Seed",
            "description": "RNG seed for rate mode (deterministic runs)"
          },
          "latency_ms": {
            "type": "integer",
            "maximum": 120000.0,
            "minimum": 0.0,
            "title": "Latency Ms",
            "default": 0
          },
          "status": {
            "type": "integer",
            "maximum": 599.0,
            "minimum": 500.0,
            "title": "Status",
            "description": "Status for the error fault",
            "default": 503
          },
          "timeout_ms": {
            "type": "integer",
            "maximum": 300000.0,
            "minimum": 0.0,
            "title": "Timeout Ms",
            "default": 30000
          }
        },
        "type": "object",
        "required": [
          "type"
        ],
        "title": "FaultSpec",
        "description": "One fault. See the module docs for the meaning of each field."
      },
      "FaultsRequest": {
        "properties": {
          "faults": {
            "items": {
              "$ref": "#/components/schemas/FaultSpec"
            },
            "type": "array",
            "title": "Faults"
          }
        },
        "type": "object",
        "title": "FaultsRequest",
        "description": "Replaces the whole active fault set. ``{\"faults\": []}`` clears every fault."
      },
      "HTTPValidationError": {
        "properties": {
          "detail": {
            "items": {
              "$ref": "#/components/schemas/ValidationError"
            },
            "type": "array",
            "title": "Detail"
          }
        },
        "type": "object",
        "title": "HTTPValidationError"
      },
      "LoginRequest": {
        "properties": {
          "username": {
            "type": "string",
            "maxLength": 64,
            "minLength": 1,
            "title": "Username",
            "description": "The customer's username"
          },
          "password": {
            "type": "string",
            "maxLength": 256,
            "minLength": 1,
            "title": "Password",
            "description": "The customer's password"
          }
        },
        "type": "object",
        "required": [
          "username",
          "password"
        ],
        "title": "LoginRequest"
      },
      "MeResponse": {
        "properties": {
          "customer_id": {
            "type": "string",
            "format": "uuid",
            "title": "Customer Id"
          },
          "username": {
            "type": "string",
            "title": "Username"
          },
          "display_name": {
            "type": "string",
            "title": "Display Name"
          }
        },
        "type": "object",
        "required": [
          "customer_id",
          "username",
          "display_name"
        ],
        "title": "MeResponse"
      },
      "RefreshRequest": {
        "properties": {
          "refresh_token": {
            "type": "string",
            "maxLength": 256,
            "minLength": 1,
            "title": "Refresh Token",
            "description": "Current refresh token"
          }
        },
        "type": "object",
        "required": [
          "refresh_token"
        ],
        "title": "RefreshRequest"
      },
      "TokenResponse": {
        "properties": {
          "access_token": {
            "type": "string",
            "title": "Access Token",
            "description": "RS256 JWT, valid for 15 minutes"
          },
          "token_type": {
            "type": "string",
            "title": "Token Type",
            "description": "Always Bearer",
            "default": "Bearer"
          },
          "expires_in": {
            "type": "integer",
            "title": "Expires In",
            "description": "Access token lifetime in seconds"
          },
          "refresh_token": {
            "type": "string",
            "title": "Refresh Token",
            "description": "Opaque token, valid 7 days, rotates on every use"
          },
          "refresh_expires_in": {
            "type": "integer",
            "title": "Refresh Expires In",
            "description": "Refresh token lifetime in seconds"
          },
          "customer_id": {
            "type": "string",
            "format": "uuid",
            "title": "Customer Id"
          }
        },
        "type": "object",
        "required": [
          "access_token",
          "expires_in",
          "refresh_token",
          "refresh_expires_in",
          "customer_id"
        ],
        "title": "TokenResponse"
      },
      "ValidationError": {
        "properties": {
          "loc": {
            "items": {
              "anyOf": [
                {
                  "type": "string"
                },
                {
                  "type": "integer"
                }
              ]
            },
            "type": "array",
            "title": "Location"
          },
          "msg": {
            "type": "string",
            "title": "Message"
          },
          "type": {
            "type": "string",
            "title": "Error Type"
          },
          "input": {
            "title": "Input"
          },
          "ctx": {
            "type": "object",
            "title": "Context"
          }
        },
        "type": "object",
        "required": [
          "loc",
          "msg",
          "type"
        ],
        "title": "ValidationError"
      }
    }
  }
}