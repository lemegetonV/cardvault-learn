  "openapi": "3.1.0",
  "info": {
    "title": "CardVault card-service",
    "description": "Card master for CardVault Bank: the customer's cards and their lifecycle, plus the authorization decision, holds and clearing for purchases arriving from the card network. The full card number never leaves this service.",
    "version": "0.1.0"
  },
