  "components": {
    "schemas": {
      "AuthorizationRequest": {
        "properties": {
          "trace_id": {
            "type": "string",
            "maxLength": 64,
            "minLength": 1,
            "title": "Trace Id",
            "description": "Network trace ID; unique"
          },
          "card_id": {
            "type": "string",
            "format": "uuid",
            "title": "Card Id",
            "description": "The card being charged"
          },
          "token_ref": {
            "anyOf": [
              {
                "type": "string",
                "maxLength": 64
              },
              {
                "type": "null"
              }
            ],
            "title": "Token Ref",
            "description": "Wallet token (WALLET only)"
          },
          "token_requestor": {
            "type": "string",
            "enum": [
              "WALLET",
              "CARD"
            ],
            "title": "Token Requestor",
            "description": "WALLET for wallet-token purchases, CARD for plain card purchases"
          },
          "amount": {
            "type": "integer",
            "exclusiveMinimum": 0.0,
            "title": "Amount",
            "description": "Amount in cents, > 0"
          },
          "currency": {
            "type": "string",
            "const": "USD",
            "title": "Currency",
            "description": "Only USD is supported"
          },
          "merchant_name": {
            "type": "string",
            "maxLength": 200,
            "minLength": 1,
            "title": "Merchant Name",
            "description": "Untrusted free text"
          },
          "mcc": {
            "type": "string",
            "pattern": "^\\d{4}$",
            "title": "Mcc",
            "description": "Merchant category code, 4 digits"
          }
        },
        "type": "object",
        "required": [
          "trace_id",
          "card_id",
          "token_requestor",
          "amount",
          "currency",
          "merchant_name",
          "mcc"
        ],
        "title": "AuthorizationRequest"
      },
      "AuthorizationResponse": {
        "properties": {
          "trace_id": {
            "type": "string",
            "title": "Trace Id"
          },
          "card_id": {
            "type": "string",
            "format": "uuid",
            "title": "Card Id"
          },
          "decision": {
            "type": "string",
            "enum": [
              "APPROVED",
              "DECLINED"
            ],
            "title": "Decision"
          },
