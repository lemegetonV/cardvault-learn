          {
            "name": "limit",
            "in": "query",
            "required": false,
            "schema": {
              "type": "integer",
              "maximum": 100,
              "minimum": 1,
              "description": "Page size, 1 to 100 (default 20)",
              "default": 20,
              "title": "Limit"
