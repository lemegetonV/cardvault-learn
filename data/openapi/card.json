    "/internal/v1/authorizations": {
      "post": {
        "tags": [
          "internal"
        ],
        "summary": "Decide an authorization",
        "description": "Called by the card network for every purchase. Checks, in order: card LOST, card CLOSED, card expired, token not mapped to the card (WALLET), token not ENROLLED in the local copy of enrolment status (WALLET), amount above available. Approval creates a hold and reduces available. Both outcomes publish auth.decided. A repeated trace_id returns the original decision and creates no second hold.",
        "operationId": "authorize_internal_v1_authorizations_post",
        "requestBody": {
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/AuthorizationRequest"
              }
            }
          },
          "required": true
        },
        "responses": {
          "200": {
            "description": "Successful Response",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/AuthorizationResponse"
                }
              }
            }
          },
          "401": {
            "description": "Missing or wrong X-Service-Key",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ErrorBody"
                }
              }
            }
          },
          "404": {
            "description": "Not Found",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ErrorBody"
                }
              }
            }
          },
          "409": {
            "description": "Conflict",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ErrorBody"
                }
              }
            }
          },
          "422": {
            "description": "Unprocessable Entity",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ErrorBody"
                }
              }
            }
          }
        }
      }
    },
    "/internal/v1/clearing": {
      "post": {
        "tags": [
          "internal"
        ],
        "summary": "Apply a clearing record",
        "description": "SETTLE settles the hold at the cleared amount (it may differ from the authorization; only CREDIT may go above the hold). REVERSE releases all or part of an unsettled hold. REFUND credits up to cleared minus already refunded; DEBIT and PREPAID never go above their limit. Idempotent by clearing_id. Publishes txn.cleared.",
        "operationId": "clearing_internal_v1_clearing_post",
        "requestBody": {
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/ClearingRequest"
              }
            }
          },
          "required": true
        },
        "responses": {
          "200": {
            "description": "Successful Response",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ClearingResponse"
                }
              }
            }
          },
          "401": {
