    "/v1/wallet/transactions": {
      "get": {
        "tags": [
          "transactions"
        ],
        "summary": "List my wallet transactions",
        "description": "Newest first (ties broken by txn_id), 20 per page by default. `card_id` and `status` may repeat. `from` and `to` are inclusive. Only the caller's transactions.",
        "operationId": "list_transactions_v1_wallet_transactions_get",
        "parameters": [
          {
            "name": "cursor",
            "in": "query",
            "required": false,
            "schema": {
              "anyOf": [
                {
                  "type": "string"
                },
                {
                  "type": "null"
                }
              ],
              "description": "next_cursor from the previous page",
              "title": "Cursor"
            },
            "description": "next_cursor from the previous page"
          },
          {
            "name": "card_id",
            "in": "query",
            "required": false,
            "schema": {
              "anyOf": [
                {
                  "type": "array",
                  "items": {
                    "type": "string",
                    "format": "uuid"
                  }
                },
                {
                  "type": "null"
                }
              ],
              "description": "Repeat for several cards",
              "title": "Card Id"
            },
            "description": "Repeat for several cards"
          },
          {
            "name": "status",
            "in": "query",
            "required": false,
            "schema": {
              "anyOf": [
                {
                  "type": "array",
                  "items": {
                    "enum": [
                      "AUTHORIZED",
                      "DECLINED",
                      "SETTLED",
                      "PARTIALLY_REVERSED",
                      "REVERSED",
                      "REFUNDED",
                      "PARTIALLY_REFUNDED"
                    ],
                    "type": "string"
                  }
                },
                {
                  "type": "null"
                }
              ],
              "description": "Repeat for several statuses",
              "title": "Status"
            },
            "description": "Repeat for several statuses"
          },
          {
            "name": "from",
            "in": "query",
            "required": false,
            "schema": {
              "anyOf": [
                {
                  "type": "string"
                },
                {
                  "type": "null"
                }
              ],
              "description": "Inclusive lower bound: an ISO 8601 datetime with offset, or a date (start of that UTC day)",
              "title": "From"
            },
            "description": "Inclusive lower bound: an ISO 8601 datetime with offset, or a date (start of that UTC day)"
          },
          {
            "name": "to",
            "in": "query",
            "required": false,
            "schema": {
              "anyOf": [
                {
                  "type": "string"
                },
                {
                  "type": "null"
                }
              ],
              "description": "Inclusive upper bound: an ISO 8601 datetime with offset, or a date (end of that UTC day)",
              "title": "To"
            },
            "description": "Inclusive upper bound: an ISO 8601 datetime with offset, or a date (end of that UTC day)"
          },
          {
            "name": "limit",
            "in": "query",
            "required": false,
            "schema": {
              "type": "integer",
              "maximum": 100,
              "minimum": 1,
              "description": "Page size, 1 to 100 (default 20)",
              "default": 20,
              "title": "Limit"
            },
            "description": "Page size, 1 to 100 (default 20)"
          }
        ],
        "responses": {
          "200": {
            "description": "Successful Response",
            "content": {
              "application/json": {
