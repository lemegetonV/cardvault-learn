{
  "openapi": "3.1.0",
  "info": {
    "title": "CardVault wallet-txn-service",
    "description": "System of record for wallet transactions: built from the auth.decided and txn.cleared events of wallet purchases, with the customer's transaction list, a CSV export and disputes.",
    "version": "0.1.0"
  },
