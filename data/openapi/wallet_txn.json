    "/v1/wallet/transactions/export": {
      "get": {
        "tags": [
          "transactions"
        ],
        "summary": "Export my wallet transactions as CSV",
        "description": "Same filters as the list (no paging; at most 10,000 rows, newest first). Columns: txn_id, occurred_at_utc, card_id, merchant_name, mcc, status, decline_code, amount, cleared_amount, reversed_amount, refunded_amount, currency, settled_at_utc. Amounts are dollars with 2 decimals, times are UTC (ISO 8601 with Z). A cell that starts with =, +, -, @, tab or CR is prefixed with ' so spreadsheets do not run it. Filename: wallet-transactions-<from>-<to>.csv, with \"all\" for an omitted bound.",
        "operationId": "export_transactions_v1_wallet_transactions_export_get",
        "parameters": [
          {
            "name": "card_id",
            "in": "query",
            "required": false,
            "schema": {
              "anyOf": [
                {
                  "type": "array",
                  "items": {
                    "type": "string",
                    "format": "uuid"
                  }
                },
                {
                  "type": "null"
                }
              ],
              "description": "Repeat for several cards",
              "title": "Card Id"
            },
            "description": "Repeat for several cards"
          },
          {
            "name": "status",
            "in": "query",
            "required": false,
            "schema": {
              "anyOf": [
                {
                  "type": "array",
                  "items": {
                    "enum": [
                      "AUTHORIZED",
                      "DECLINED",
                      "SETTLED",
                      "PARTIALLY_REVERSED",
                      "REVERSED",
                      "REFUNDED",
                      "PARTIALLY_REFUNDED"
                    ],
                    "type": "string"
                  }
                },
                {
                  "type": "null"
                }
              ],
              "description": "Repeat for several statuses",
              "title": "Status"
            },
            "description": "Repeat for several statuses"
          },
          {
            "name": "from",
            "in": "query",
            "required": false,
            "schema": {
              "anyOf": [
                {
                  "type": "string"
                },
                {
                  "type": "null"
                }
              ],
              "description": "Inclusive lower bound: an ISO 8601 datetime with offset, or a date (start of that UTC day)",
              "title": "From"
            },
            "description": "Inclusive lower bound: an ISO 8601 datetime with offset, or a date (start of that UTC day)"
          },
          {
            "name": "to",
            "in": "query",
            "required": false,
            "schema": {
              "anyOf": [
                {
                  "type": "string"
                },
                {
                  "type": "null"
                }
              ],
              "description": "Inclusive upper bound: an ISO 8601 datetime with offset, or a date (end of that UTC day)",
              "title": "To"
            },
            "description": "Inclusive upper bound: an ISO 8601 datetime with offset, or a date (end of that UTC day)"
          }
        ],
        "responses": {
          "200": {
            "description": "Successful Response",
            "content": {
              "text/csv": {}
            }
