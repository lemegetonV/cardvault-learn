    "/v1/wallet/transactions/{txn_id}/disputes": {
      "post": {
        "tags": [
          "disputes"
        ],
        "summary": "Dispute one of my transactions",
        "description": "multipart/form-data: `reason` (UNRECOGNISED, DUPLICATE, WRONG_AMOUNT or NOT_RECEIVED), optional `note` (at most 500 characters) and optional `receipt` (PDF, PNG or JPEG, at most 5,242,880 bytes, type detected from the content). Only AUTHORIZED, SETTLED, PARTIALLY_REVERSED and PARTIALLY_REFUNDED transactions can be disputed (otherwise 422 TRANSACTION_NOT_DISPUTABLE), and only once while a dispute is OPEN (409 DISPUTE_ALREADY_OPEN). Accepts `Idempotency-Key`; the fingerprint is the fields and the receipt's SHA-256, so a retry of the same form replays the first answer.",
        "operationId": "open_dispute_v1_wallet_transactions__txn_id__disputes_post",
        "parameters": [
          {
            "name": "txn_id",
            "in": "path",
            "required": true,
            "schema": {
              "type": "string",
              "format": "uuid",
              "description": "The transaction's txn_id (UUID)",
              "title": "Txn Id"
            },
            "description": "The transaction's txn_id (UUID)"
          }
        ],
        "requestBody": {
          "required": true,
          "content": {
            "multipart/form-data": {
              "schema": {
                "$ref": "#/components/schemas/Body_open_dispute_v1_wallet_transactions__txn_id__disputes_post"
              }
            }
          }
        },
        "responses": {
          "201": {
            "description": "Successful Response",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/DisputeView"
