{
  "openapi": "3.1.0",
  "info": {
    "title": "CardVault profile-service",
    "description": "Customer contact details for CardVault Bank: email and phone, their verification with one-time codes, and the contact.updated event that keeps wallet eligibility in step.",
    "version": "0.1.0"
  },
  "paths": {
    "/health": {
      "get": {
        "tags": [
          "health"
        ],
        "summary": "Liveness",
        "description": "200 while the process is up.",
        "operationId": "health_health_get",
        "responses": {
          "200": {
            "description": "Successful Response",
            "content": {
              "application/json": {
                "schema": {
                  "additionalProperties": true,
                  "type": "object",
                  "title": "Response Health Health Get"
                }
              }
            }
          }
        }
      }
    },
    "/ready": {
      "get": {
        "tags": [
          "health"
        ],
        "summary": "Readiness",
        "description": "200 when the service's database (and Kafka, if it uses Kafka) answer.",
        "operationId": "ready_ready_get",
        "responses": {
          "200": {
            "description": "Successful Response",
            "content": {
              "application/json": {
                "schema": {}
              }
            }
          },
          "503": {
            "description": "A dependency is not reachable"
          }
        }
      }
    },
    "/v1/profile": {
      "get": {
        "tags": [
          "profile"
        ],
        "summary": "Get my profile",
        "description": "Contact details and their verification flags. The ETag is the version.",
        "operationId": "get_profile_v1_profile_get",
        "responses": {
          "200": {
            "description": "Successful Response",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ProfileView"
                }
              }
            }
          },
          "401": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ErrorBody"
                }
              }
            },
            "description": "Unauthorized"
          },
          "404": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ErrorBody"
                }
              }
            },
            "description": "Not Found"
          }
        }
      },
      "patch": {
        "tags": [
          "profile"
        ],
        "summary": "Change my email or phone",
        "description": "A changed email or phone must be verified again; the same value keeps its flag. Send `If-Match: <version>` to avoid overwriting a newer change: a mismatch returns 412 VERSION_MISMATCH. Publishes contact.updated when anything changed.",
        "operationId": "patch_profile_v1_profile_patch",
        "parameters": [
          {
            "name": "if-match",
            "in": "header",
            "required": false,
            "schema": {
              "anyOf": [
                {
                  "type": "string"
                },
                {
                  "type": "null"
                }
              ],
              "description": "The version you last read",
              "title": "If-Match"
            },
            "description": "The version you last read"
          }
        ],
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/ProfilePatch"
              }
            }
          }
        },
        "responses": {
          "200": {
            "description": "Successful Response",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ProfileView"
                }
              }
            }
          },
          "401": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ErrorBody"
                }
              }
            },
            "description": "Unauthorized"
          },
          "404": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ErrorBody"
                }
              }
            },
            "description": "Not Found"
          },
          "412": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ErrorBody"
                }
              }
            },
            "description": "Precondition Failed"
          },
          "422": {
            "description": "Validation Error",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/HTTPValidationError"
                }
              }
            }
          }
        }
      }
    },
    "/v1/profile/verify/send": {
      "post": {
        "tags": [
          "profile"
        ],
        "summary": "Send a verification code",
        "description": "Sends a one-time code to the email or phone. At most one code every 30 seconds per channel (429 OTP_COOLDOWN with details.retry_after_seconds). Under TEST_MODE nothing is delivered and the code is always 000000. Accepts `Idempotency-Key`.",
        "operationId": "send_code_v1_profile_verify_send_post",
        "requestBody": {
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/SendRequest"
              }
            }
          },
          "required": true
        },
        "responses": {
          "202": {
            "description": "Successful Response",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/SendResponse"
                }
              }
            }
          },
          "401": {
            "description": "Unauthorized",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ErrorBody"
                }
              }
            }
          },
          "404": {
            "description": "Not Found",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ErrorBody"
                }
              }
            }
          },
          "409": {
            "description": "Conflict",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ErrorBody"
                }
              }
            }
          },
          "422": {
            "description": "Unprocessable Entity",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ErrorBody"
                }
              }
            }
          },
          "429": {
            "description": "Too Many Requests",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ErrorBody"
                }
              }
            }
          }
        }
      }
    },
    "/v1/profile/verify": {
      "post": {
        "tags": [
          "profile"
        ],
        "summary": "Verify my email or phone with a code",
        "description": "Marks the channel verified when the code is right (000000 under TEST_MODE) and publishes contact.updated. A wrong code returns 422 OTP_INVALID with details.attempts_remaining; the fifth wrong code locks the channel for 15 minutes (423 OTP_LOCKED). An already verified channel returns 200 unchanged. Accepts `Idempotency-Key`.",
        "operationId": "verify_v1_profile_verify_post",
        "requestBody": {
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/VerifyRequest"
              }
            }
          },
          "required": true
        },
        "responses": {
          "200": {
            "description": "Successful Response",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ProfileView"
                }
              }
            }
          },
          "401": {
            "description": "Unauthorized",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ErrorBody"
                }
              }
            }
          },
          "404": {
            "description": "Not Found",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ErrorBody"
                }
              }
            }
          },
          "422": {
            "description": "Unprocessable Entity",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ErrorBody"
                }
              }
            }
          },
          "423": {
            "description": "Locked",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ErrorBody"
                }
              }
            }
          }
        }
      }
    },
    "/test/reset": {
      "post": {
        "tags": [
          "test-support"
        ],
        "summary": "Reset this service",
        "description": "Truncates this service's tables, clears faults, idempotency keys and lockouts, and skips consumers to the end of their topics.",
        "operationId": "reset_test_reset_post",
        "responses": {
          "200": {
            "description": "Successful Response",
            "content": {
              "application/json": {
                "schema": {
                  "additionalProperties": true,
                  "type": "object",
                  "title": "Response Reset Test Reset Post"
                }
              }
            }
          }
        }
      }
    },
    "/test/seed": {
      "post": {
        "tags": [
          "test-support"
        ],
        "summary": "Load seed data",
        "description": "Resets this service, then writes the deterministic seed data.",
        "operationId": "seed_test_seed_post",
        "responses": {
          "200": {
            "description": "Successful Response",
            "content": {
              "application/json": {
                "schema": {
                  "additionalProperties": true,
                  "type": "object",
                  "title": "Response Seed Test Seed Post"
                }
              }
            }
          }
        }
      }
    },
    "/test/faults": {
      "get": {
        "tags": [
          "test-support"
        ],
        "summary": "List active faults",
        "operationId": "get_faults_test_faults_get",
        "responses": {
          "200": {
            "description": "Successful Response",
            "content": {
              "application/json": {
                "schema": {
                  "additionalProperties": true,
                  "type": "object",
                  "title": "Response Get Faults Test Faults Get"
                }
              }
            }
          }
        }
      },
      "post": {
        "tags": [
          "test-support"
        ],
        "summary": "Replace the active fault set",
        "operationId": "set_faults_test_faults_post",
        "requestBody": {
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/FaultsRequest"
              }
            }
          },
          "required": true
        },
        "responses": {
          "200": {
            "description": "Successful Response",
            "content": {
              "application/json": {
                "schema": {
                  "additionalProperties": true,
                  "type": "object",
                  "title": "Response Set Faults Test Faults Post"
                }
              }
            }
          },
          "422": {
            "description": "Validation Error",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/HTTPValidationError"
                }
              }
            }
          }
        }
      }
    },
    "/test/clock": {
      "get": {
        "tags": [
          "test-support"
        ],
        "summary": "Read the effective time",
        "operationId": "get_clock_test_clock_get",
        "responses": {
          "200": {
            "description": "Successful Response",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ClockView"
                }
              }
            }
          }
        }
      },
      "post": {
        "tags": [
          "test-support"
        ],
        "summary": "Move the shared clock",
        "description": "Writes the single shared offset row. Returns once this service sees the new time; other services follow within 1 second.",
        "operationId": "set_clock_test_clock_post",
        "requestBody": {
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/ClockRequest"
              }
            }
          },
          "required": true
        },
        "responses": {
          "200": {
            "description": "Successful Response",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ClockView"
                }
              }
            }
          },
          "422": {
            "description": "Validation Error",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/HTTPValidationError"
                }
              }
            }
          }
        }
      }
    },
    "/test/quiet": {
      "get": {
        "tags": [
          "test-support"
        ],
        "summary": "Is anything in flight?",
        "description": "Outbox depth and consumer lag. quiet=true when both are zero.",
        "operationId": "quiet_test_quiet_get",
        "responses": {
          "200": {
            "description": "Successful Response",
            "content": {
              "application/json": {
                "schema": {
                  "additionalProperties": true,
                  "type": "object",
                  "title": "Response Quiet Test Quiet Get"
                }
              }
            }
          }
        }
      }
    },
    "/test/bugs": {
      "get": {
        "tags": [
          "test-support"
        ],
        "summary": "Seeded-bug flags that are on in this service",
        "operationId": "active_bugs_test_bugs_get",
        "responses": {
          "200": {
            "description": "Successful Response",
            "content": {
              "application/json": {
                "schema": {
                  "additionalProperties": true,
                  "type": "object",
                  "title": "Response Active Bugs Test Bugs Get"
                }
              }
            }
          }
        }
      }
    },
    "/test/profiles": {
      "post": {
        "tags": [
          "test-support"
        ],
        "summary": "Create a profile (test support)",
        "description": "Used by the POST /test/customers orchestrator. Email and phone default to fictional values derived from the customer_id.",
        "operationId": "create_profile_test_profiles_post",
        "requestBody": {
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/TestProfileRequest"
              }
            }
          },
          "required": true
        },
        "responses": {
          "201": {
            "description": "Successful Response",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ProfileView"
                }
              }
            }
          },
          "422": {
            "description": "Validation Error",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/HTTPValidationError"
                }
              }
            }
          }
        }
      }
    }
  },
  "components": {
    "schemas": {
      "ClockRequest": {
        "properties": {
          "offset_seconds": {
            "anyOf": [
              {
                "type": "number"
              },
              {
                "type": "null"
              }
            ],
            "title": "Offset Seconds",
            "description": "Set the offset from real time"
          },
          "advance_seconds": {
            "anyOf": [
              {
                "type": "number"
              },
              {
                "type": "null"
              }
            ],
            "title": "Advance Seconds",
            "description": "Move the clock by this much"
          },
          "now": {
            "anyOf": [
              {
                "type": "string",
                "format": "date-time"
              },
              {
                "type": "null"
              }
            ],
            "title": "Now",
            "description": "Set the effective time (timezone-aware)"
          },
          "reset": {
            "anyOf": [
              {
                "type": "boolean"
              },
              {
                "type": "null"
              }
            ],
            "title": "Reset",
            "description": "true clears the offset (real time)"
          }
        },
        "type": "object",
        "title": "ClockRequest",
        "description": "Exactly one of the fields. The offset applies to every service at once."
      },
      "ClockView": {
        "properties": {
          "now": {
            "type": "string",
            "format": "date-time",
            "title": "Now"
          },
          "real_now": {
            "type": "string",
            "format": "date-time",
            "title": "Real Now"
          },
          "offset_seconds": {
            "type": "number",
            "title": "Offset Seconds"
          },
          "service": {
            "type": "string",
            "title": "Service"
          }
        },
        "type": "object",
        "required": [
          "now",
          "real_now",
          "offset_seconds",
          "service"
        ],
        "title": "ClockView"
      },
      "ErrorBody": {
        "properties": {
          "error_code": {
            "type": "string",
            "title": "Error Code"
          },
          "message": {
            "type": "string",
            "title": "Message"
          },
          "correlation_id": {
            "anyOf": [
              {
                "type": "string"
              },
              {
                "type": "null"
              }
            ],
            "title": "Correlation Id"
          },
          "details": {
            "anyOf": [
              {},
              {
                "type": "null"
              }
            ],
            "title": "Details"
          }
        },
        "type": "object",
        "required": [
          "error_code",
          "message",
          "correlation_id"
        ],
        "title": "ErrorBody",
        "description": "The common error response body."
      },
      "FaultScope": {
        "properties": {
          "method": {
            "anyOf": [
              {
                "type": "string"
              },
              {
                "type": "null"
              }
            ],
            "title": "Method",
            "description": "HTTP method to match, e.g. POST"
          },
          "path": {
            "anyOf": [
              {
                "type": "string"
              },
              {
                "type": "null"
              }
            ],
            "title": "Path",
            "description": "Exact path, or a prefix ending in *"
          },
          "topic": {
            "anyOf": [
              {
                "type": "string"
              },
              {
                "type": "null"
              }
            ],
            "title": "Topic",
            "description": "Kafka topic, for Kafka faults"
          }
        },
        "type": "object",
        "title": "FaultScope"
      },
      "FaultSpec": {
        "properties": {
          "type": {
            "type": "string",
            "enum": [
              "latency",
              "error",
              "timeout",
              "kafka_publish_failure",
              "consumer_pause",
              "relay_pause"
            ],
            "title": "Type"
          },
          "scope": {
            "$ref": "#/components/schemas/FaultScope"
          },
          "fail_next": {
            "anyOf": [
              {
                "type": "integer",
                "minimum": 1.0
              },
              {
                "type": "null"
              }
            ],
            "title": "Fail Next",
            "description": "Fire on the next N matches only"
          },
          "rate": {
            "anyOf": [
              {
                "type": "number",
                "maximum": 1.0,
                "exclusiveMinimum": 0.0
              },
              {
                "type": "null"
              }
            ],
            "title": "Rate",
            "description": "Probability of firing per match"
          },
          "seed": {
            "anyOf": [
              {
                "type": "integer"
              },
              {
                "type": "null"
              }
            ],
            "title": "Seed",
            "description": "RNG seed for rate mode (deterministic runs)"
          },
          "latency_ms": {
            "type": "integer",
            "maximum": 120000.0,
            "minimum": 0.0,
            "title": "Latency Ms",
            "default": 0
          },
          "status": {
            "type": "integer",
            "maximum": 599.0,
            "minimum": 500.0,
            "title": "Status",
            "description": "Status for the error fault",
            "default": 503
          },
          "timeout_ms": {
            "type": "integer",
            "maximum": 300000.0,
            "minimum": 0.0,
            "title": "Timeout Ms",
            "default": 30000
          }
        },
        "type": "object",
        "required": [
          "type"
        ],
        "title": "FaultSpec",
        "description": "One fault. See the module docs for the meaning of each field."
      },
      "FaultsRequest": {
        "properties": {
          "faults": {
            "items": {
              "$ref": "#/components/schemas/FaultSpec"
            },
            "type": "array",
            "title": "Faults"
          }
        },
        "type": "object",
        "title": "FaultsRequest",
        "description": "Replaces the whole active fault set. ``{\"faults\": []}`` clears every fault."
      },
      "HTTPValidationError": {
        "properties": {
          "detail": {
            "items": {
              "$ref": "#/components/schemas/ValidationError"
            },
            "type": "array",
            "title": "Detail"
          }
        },
        "type": "object",
        "title": "HTTPValidationError"
      },
      "ProfilePatch": {
        "properties": {
          "email": {
            "anyOf": [
              {
                "type": "string",
                "maxLength": 254
              },
              {
                "type": "null"
              }
            ],
            "title": "Email",
            "description": "New email address"
          },
          "phone": {
            "anyOf": [
              {
                "type": "string"
              },
              {
                "type": "null"
              }
            ],
            "title": "Phone",
            "description": "New phone number, E.164 (e.g. +15550100101)"
          }
        },
        "type": "object",
        "title": "ProfilePatch",
        "description": "Only the fields that are sent change."
      },
      "ProfileView": {
        "properties": {
          "customer_id": {
            "type": "string",
            "title": "Customer Id"
          },
          "email": {
            "anyOf": [
              {
                "type": "string"
              },
              {
                "type": "null"
              }
            ],
            "title": "Email",
            "description": "Email address"
          },
          "email_verified": {
            "type": "boolean",
            "title": "Email Verified"
          },
          "phone": {
            "anyOf": [
              {
                "type": "string"
              },
              {
                "type": "null"
              }
            ],
            "title": "Phone",
            "description": "Phone number in E.164 format, e.g. +15550100101"
          },
          "phone_verified": {
            "type": "boolean",
            "title": "Phone Verified"
          },
          "version": {
            "type": "integer",
            "title": "Version",
            "description": "Send it back in If-Match to update safely"
          },
          "updated_at": {
            "type": "string",
            "format": "date-time",
            "title": "Updated At"
          }
        },
        "type": "object",
        "required": [
          "customer_id",
          "email",
          "email_verified",
          "phone",
          "phone_verified",
          "version",
          "updated_at"
        ],
        "title": "ProfileView"
      },
      "SendRequest": {
        "properties": {
          "channel": {
            "type": "string",
            "enum": [
              "EMAIL",
              "PHONE"
            ],
            "title": "Channel",
            "description": "Which contact to verify: EMAIL or PHONE"
          }
        },
        "type": "object",
        "required": [
          "channel"
        ],
        "title": "SendRequest"
      },
      "SendResponse": {
        "properties": {
          "channel": {
            "type": "string",
            "enum": [
              "EMAIL",
              "PHONE"
            ],
            "title": "Channel"
          },
          "sent_to": {
            "type": "string",
            "title": "Sent To",
            "description": "Masked destination"
          },
          "cooldown_seconds": {
            "type": "integer",
            "title": "Cooldown Seconds",
            "description": "Seconds before another code can be requested"
          }
        },
        "type": "object",
        "required": [
          "channel",
          "sent_to",
          "cooldown_seconds"
        ],
        "title": "SendResponse"
      },
      "TestProfileRequest": {
        "properties": {
          "email": {
            "anyOf": [
              {
                "type": "string",
                "maxLength": 254
              },
              {
                "type": "null"
              }
            ],
            "title": "Email",
            "description": "New email address"
          },
          "phone": {
            "anyOf": [
              {
                "type": "string"
              },
              {
                "type": "null"
              }
            ],
