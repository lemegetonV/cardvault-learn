# The stage VM, reached through the SSH tunnel (see README "Running against stage").
# Secrets are not here: put them in tests/api/.env.stage (git-ignored), copied from
# .env.stage.example, or export them as environment variables.
AUTH_URL=http://127.0.0.1:18001
CARD_URL=http://127.0.0.1:18002
ENROLLMENT_URL=http://127.0.0.1:18003
WALLET_TXN_URL=http://127.0.0.1:18004
PROFILE_URL=http://127.0.0.1:18005
OPERATOR_URL=http://127.0.0.1:18101
NETWORK_URL=http://127.0.0.1:18102

SEED_USER_PASSWORD=CardVault-Demo-1

DB_HOST=127.0.0.1
DB_PORT=15432
KAFKA_BOOTSTRAP=127.0.0.1:29092

# Stage is shared: reset and reseed it at the start of a run, as local does.
RESET_AT_START=true
# The VM is small; give slow calls more room.
HTTP_TIMEOUT_SECONDS=20
