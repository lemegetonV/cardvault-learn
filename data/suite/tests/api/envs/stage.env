# Stage: CardVault on the shared server, reached through an SSH tunnel that
# forwards these ports from your computer to the server. Run the tests with:
#   TEST_ENV=stage pytest
# Secrets do not go here. Set them yourself before the run:
#   export TEST_KEY=...  DB_READONLY_PASSWORD=...
AUTH_URL=http://localhost:18001
CARD_URL=http://localhost:18002
WALLET_URL=http://localhost:18003
TRANSACTIONS_URL=http://localhost:18004
PROFILE_URL=http://localhost:18005
CARD_NETWORK_URL=http://localhost:18102
DB_PORT=15432
KAFKA_BOOTSTRAP=127.0.0.1:29092
# The server is further away than your own computer, so allow a little more time.
MAX_RESPONSE_SECONDS=2
