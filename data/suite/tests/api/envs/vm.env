# Stage, from the stage VM itself (the runner in runner/ uses this): the stack's own local
# ports, no tunnel. Secrets go in tests/api/.env.vm on the VM (git-ignored), copied from
# .env.stage.example and filled in from /opt/cardvault/.env.
AUTH_URL=http://127.0.0.1:8001
CARD_URL=http://127.0.0.1:8002
ENROLLMENT_URL=http://127.0.0.1:8003
WALLET_TXN_URL=http://127.0.0.1:8004
PROFILE_URL=http://127.0.0.1:8005
OPERATOR_URL=http://127.0.0.1:8101
NETWORK_URL=http://127.0.0.1:8102

SEED_USER_PASSWORD=CardVault-Demo-1

DB_HOST=127.0.0.1
DB_PORT=5432
KAFKA_BOOTSTRAP=127.0.0.1:19092

# Stage is shared: reset and reseed it at the start of a run, as local does.
RESET_AT_START=true
# The VM is small; give slow calls more room.
HTTP_TIMEOUT_SECONDS=20
